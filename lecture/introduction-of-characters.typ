#import "../utils.typ":chara,avatar
#let header-text=place(
	center+horizon,
		text(
		size:30pt,
		weight:"semibold",
		[主要出场人物],
	)
)
#show:page.with(
	header:context place(
		top,
		dx:-page.margin.outside,
		block(
			fill:silver,
			width:page.width,
			height:100%,
			header-text,
		),
	),
	footer:none,
)
#grid(
	columns:(1fr,8fr),
	align:horizon,
	inset:(
		y:2mm,
	),
	avatar(chara.杨秉),
	[
		杨秉，男，43岁，教授。
	],
	avatar(chara.严佩),
	[
		严佩，男，36岁，讲师。
	],
	avatar(chara.温舒),
	[
		温舒，女，24岁，助教。
	],
	avatar(chara.牛弘),
	[
		牛弘，男，22岁，助教。
	],
)
